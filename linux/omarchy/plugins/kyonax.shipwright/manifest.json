{
  "schemaVersion": 1,
  "id": "kyonax.shipwright",
  "name": "Shipwright",
  "version": "1.0.0",
  "author": "kyonax",
  "license": "MIT",
  "description": "Shipwright git auto-save fleet status in the Omarchy bar: what needs you, your GitHub contributions, per-repo sync state, and open PRs.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Shipwright",
    "description": "Git auto-save fleet health, your GitHub contribution strip, and what needs you.",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 300
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Full re-check interval (seconds)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 300
      },
      {
        "key": "activityWeeks",
        "type": "integer",
        "label": "Activity window (weeks)",
        "min": 1,
        "max": 53,
        "step": 1,
        "defaultValue": 26
      }
    ]
  }
}